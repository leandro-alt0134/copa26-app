# Ambientes públicos do frontend - Copa do Mundo 2026 Simulator PWA
# NOTA: Todas as variáveis que iniciam com "VITE_" ficam públicas e expostas no bundle compilado do navegador!
# Nunca coloque chaves privadas ou senhas de banco de dados neste arquivo.

# Identificação do Ambiente
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0

# Endpoint Público do Proxy da API de Futebol (intermediador seguro que injeta a chave real de forma isolada)
# Para desenvolvimento local, pode apontar para http://localhost:8788
VITE_PUBLIC_API_BASE_URL=https://api.seudominio.com

# Recursos do PWA e Monetização
VITE_ENABLE_PWA=true
VITE_ENABLE_ADS=false
VITE_USE_TEST_ADS=true
VITE_ENABLE_ANALYTICS=false

# Google AdSense (Web/PWA)
VITE_ADSENSE_CLIENT_ID=ca-pub-SEU_ID
VITE_ADSENSE_SLOT_BANNER=SEU_SLOT
VITE_ADSENSE_SLOT_RESPONSIVE=SEU_SLOT

# Google AdMob (Nativo Capacitor)
VITE_ADMOB_ANDROID_APP_ID=ca-app-pub-SEU_ID~SEU_APP_ID
VITE_ADMOB_IOS_APP_ID=ca-app-pub-SEU_ID~SEU_APP_ID_IOS
VITE_ADMOB_BANNER_ID=ca-app-pub-SEU_ID/SEU_BANNER_ID
VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-SEU_ID/SEU_INTERSTITIAL_ID
VITE_ADMOB_REWARDED_ID=ca-app-pub-SEU_ID/SEU_REWARDED_ID
